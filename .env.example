# Safe local examples only. No credentials belong in this file.
RESOLVER_BASE_URL=http://localhost:8081
SHORTENER_BASE_URL=http://localhost:8080
SHORTENER_TIMEOUT_SECONDS=2.0
SHORT_CODE_LENGTH=8
SHORT_CODE_MAX_ATTEMPTS=5
REPOSITORY_BACKEND=memory

# Azure mode uses non-secret resource coordinates and DefaultAzureCredential.
# REPOSITORY_BACKEND=cosmos
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443
# COSMOS_DATABASE_NAME=url-shortener
# COSMOS_MAPPINGS_CONTAINER=url_mappings
# COSMOS_REDIRECT_EVENTS_CONTAINER=redirect_events
# AZURE_CLIENT_ID=<service-specific-user-assigned-identity-client-id>
# AZURE_MONITOR_ENABLED=true
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<resource-id>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
# Azure Monitor and OTLP remote export are intentionally mutually exclusive.

# Configure service name independently in each container. These examples contain no credentials.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=shortener
OTEL_EXPORT_TIMEOUT_SECONDS=2.0
OTEL_METRIC_EXPORT_INTERVAL_SECONDS=5.0
